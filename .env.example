# Copie para `.env` (que está no .gitignore) e preencha.
# No GitHub Codespaces, prefira cadastrar como "Codespaces secrets":
#   github.com/settings/codespaces -> Secrets -> New secret
# Os secrets viram variáveis de ambiente automaticamente.

# --- Chave ---
ANTHROPIC_API_KEY=

# --- Modelo padrão dos labs ---
# O mais barato da Anthropic (verificado na doc oficial em 09/11/2026)
ANTHROPIC_MODEL=claude-haiku-5-5
