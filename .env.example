# Copie para `.env` (que está no .gitignore) e preencha.
# No GitHub Codespaces, prefira cadastrar como "Codespaces secrets":
#   github.com/settings/codespaces -> Secrets -> New secret
# Os secrets viram variáveis de ambiente automaticamente.

# --- Chaves ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Modelos padrão dos labs ---
# Anthropic: o mais barato (verificado na doc oficial em 09/11/2026)
ANTHROPIC_MODEL=claude-haiku-5-5
# Gemini: um Flash-Lite do tier gratuito. Confira o nome e os limites no AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenAI: deixe vazio para pular. Se ativar o data sharing, coloque aqui um
# modelo mini/nano que o dashboard mostre como elegível.
OPENAI_MODEL=
